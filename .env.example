# ============================================================================
# ProspectIQ v2.1 — Server-Side Environment Configuration
# Secrets are read ONLY by the Node.js/Express backend and are NEVER exposed
# in client-side code or browser payloads.
# ============================================================================

PORT=3001

# 1. Google Gemini API Key (Powers company extraction, search grounding & personalized outreach)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Authorized Web Search APIs (Optional - enables automated public prospect discovery)
# Configure any ONE of the following, or rely on Gemini Search Grounding / Guided Manual Mode:
TAVILY_API_KEY=
SERPER_API_KEY=

# 3. Hunter.io Domain Search API Key (Optional - matches classroom Hunter.io decision-maker discovery)
HUNTER_API_KEY=

# 4. Brevo Email Delivery (Can also be configured & encrypted via Windows DPAPI directly in the UI Drawer!)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
